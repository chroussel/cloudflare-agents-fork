{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gradium-starter",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],

  "ai": { "binding": "AI", "remote": true },
  "secrets": { "required": ["GRADIUM_API_KEY"] },

  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },

  "durable_objects": {
    "bindings": [
      { "class_name": "VoiceChatAgent", "name": "VoiceChatAgent" },
      { "class_name": "TranslateAgent", "name": "TranslateAgent" },
      { "class_name": "VoiceDesignAgent", "name": "VoiceDesignAgent" }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["VoiceChatAgent"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["TranslateAgent"],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": ["VoiceDesignAgent"],
      "tag": "v3"
    }
  ]
}
